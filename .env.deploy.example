# Copy to .env.deploy (gitignored: the repo is public) and fill in.

# SSH destination: user@host, or a Host alias from ~/.ssh/config.
DEPLOY_HOST=deploy@203.0.113.10
# SSH port (optional, default 22).
DEPLOY_PORT=22
# Web root on the server; must match `root` in deploy/nginx/profile-site.conf.
DEPLOY_PATH=/var/www/profile-site
