# Rules every pushed branch must meet before it becomes a PR.
# Git passes one "<local ref> <local sha> <remote ref> <remote sha>" line per pushed ref.

limit=500
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main | refs/tags/*) continue ;;
  esac
  # An all-zero sha means the branch is being deleted.
  case "$local_sha" in
    *[!0]*) ;;
    *) continue ;;
  esac

  # PR size: lines added + removed since the branch left main, lockfile excluded.
  base=$(git merge-base "$local_sha" origin/main) || {
    echo "pre-push: no common ancestor with origin/main to measure ${remote_ref#refs/heads/} against." >&2
    exit 1
  }
  numstat=$(git diff --numstat "$base" "$local_sha" -- . ':(exclude)pnpm-lock.yaml')
  total=$(printf '%s\n' "$numstat" | awk '{ n += $1 + $2 } END { print n + 0 }')
  if [ "$total" -gt "$limit" ]; then
    echo "pre-push: ${remote_ref#refs/heads/} changes $total lines against origin/main (limit $limit, pnpm-lock.yaml excluded)." >&2
    echo "Largest files:" >&2
    printf '%s\n' "$numstat" | awk -F '\t' '{ print $1 + $2 "\t" $3 }' | sort -rn | head -n 5 | sed 's/^/  /' >&2
    echo "Split the work into sequential PRs (owner override: git push --no-verify)." >&2
    status=1
  fi
done

exit $status
